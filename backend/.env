APP_NAME=Academic Research Helper
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:7860,http://localhost:7860
MAX_UPLOAD_MB=25

GENERATION_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
LOCAL_GENERATOR_MODEL=google/flan-t5-base

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_COLLECTION=academic_papers

# Optional absolute paths.
# ARTIFACTS_DIR=C:/path/to/backend/data/artifacts
# VECTOR_STORE_DIR=C:/path/to/backend/data/vector_store
